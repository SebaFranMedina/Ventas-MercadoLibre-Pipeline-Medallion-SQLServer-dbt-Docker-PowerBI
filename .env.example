# Copy to .env and edit. Never commit .env.
MSSQL_SA_PASSWORD=Change-Me-Str0ng!Pass
# Secret key for HMAC pseudonymisation of buyer data. Keep it stable between runs.
PII_SECRET=change-me-generate-with-openssl-rand-hex-32
MSSQL_DB=ventas_ml
DB_HOST=sqlserver
DB_PORT=1433
DB_USER=sa
# Optional: read-only login for Power BI (schema gold only)
POWERBI_READER_PASSWORD=Reader-Str0ng!Pass1
# File to ingest (inside the container). Default = fictional sample.
INPUT_FILE=data/sample/sample_sales.xlsx
